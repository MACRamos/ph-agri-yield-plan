import pandas as pd

# 1. Load PSA Crop Yield Data
psa_df = pd.read_csv('../PSA OpenSTAT.csv')
psa_df['Geolocation'] = psa_df['Geolocation'].str.lstrip('.')

# 2. Load NASA POWER Data (Data header starts on line 12 / index 12)
nasa_df = pd.read_csv('../NASA POWER Data Access Viewer.csv', skiprows=12)

# Create Datetime column from YEAR and DOY (Day of Year)
nasa_df['Date'] = pd.to_datetime(
    nasa_df['YEAR'].astype(str) + nasa_df['DOY'].astype(str), format='%Y%j'
)

# 3. Load Open-Meteo Data (Data table header starts on line 3 / index 3)
om_df = pd.read_csv('../Open-Meteo Historical Weather API.csv', skiprows=3)
om_df = om_df[['time', 'temperature_2m (°C)']].dropna()
om_df['Date'] = pd.to_datetime(om_df['time']).dt.date

print('All 3 datasets successfully loaded and ready for feature engineering!')
